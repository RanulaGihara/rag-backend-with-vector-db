# ============================================================================
# Multi-Domain RAG Backend - Environment Variables Template
# ============================================================================
# Copy this file to '.env' inside the backend directory:
#   cp .example.env .env
# ============================================================================

# Server Configuration
PORT=5001

# Google Gemini AI Configuration (Used by @langchain/google-genai)
# Obtain key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Pinecone Vector DB Configuration
# Obtain key & index from: https://app.pinecone.io/
# Note: Ensure index is configured with 3072 dimensions and Cosine metric.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hotel-catalog

# Supabase Relational Database Configuration
# Obtain keys from: https://supabase.com/dashboard
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here